NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com/api/v1
NEXT_PUBLIC_API_KEY=replace-with-viewer-key

BACKEND_PORT=8000
FRONTEND_PORT=3000
APP_DATA_DIR=/app/app/data
RAG_DATA_DIR=/app/app/data
CORS_ORIGINS=https://your-dashboard.example.com

STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://agentic_rag:replace-with-strong-password@postgres:5432/agentic_rag
POSTGRES_DB=agentic_rag
POSTGRES_USER=agentic_rag
POSTGRES_PASSWORD=replace-with-strong-postgres-password
RAG_VECTOR_BACKEND=pgvector
RAG_PGVECTOR_TABLE=rag_chunks
QDRANT_URL=
QDRANT_COLLECTION=agentic_rag_chunks
RAG_EMBEDDING_BACKEND=sentence_transformers
RAG_EMBEDDING_MODEL=pritamdeka/S-BioBert-snli-multinli-stsb
RAG_EMBEDDING_DIMENSIONS=768
OPENAI_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
RNA_FOLDING_BACKEND=rnafold
RNAFOLD_EXECUTABLE=RNAfold
RNAFOLD_TIMEOUT_SECONDS=10
RNAFOLD_WINDOW_NT=180

API_KEYS=replace-with-admin-key,replace-with-operator-key,replace-with-viewer-key
API_KEY_ROLES=replace-with-admin-key=admin;replace-with-operator-key=operator;replace-with-viewer-key=viewer
RATE_LIMIT_PER_MINUTE=120

ARTIFACT_SIGNING_KEY=replace-with-long-random-hmac-secret
ARTIFACT_SIGNING_KEY_ID=prod-hmac-sha256-v1
ARTIFACT_ED25519_PRIVATE_KEY=
ARTIFACT_ED25519_PUBLIC_KEY=
ARTIFACT_ED25519_KEY_ID=prod-ed25519-v1

ARTIFACT_RETENTION_DAYS=365
ARTIFACT_RETENTION_KEEP_MIN=1000
ARTIFACT_OBJECT_STORE_ENABLED=true
ARTIFACT_OBJECT_STORE_ENDPOINT=https://s3.example.com
ARTIFACT_OBJECT_STORE_BUCKET=agentic-rag-prod-artifacts
ARTIFACT_OBJECT_STORE_PREFIX=agentic-rag/artifacts
ARTIFACT_OBJECT_STORE_REGION=us-east-1
ARTIFACT_OBJECT_STORE_ACCESS_KEY_ID=replace-with-object-store-access-key
ARTIFACT_OBJECT_STORE_SECRET_ACCESS_KEY=replace-with-object-store-secret-key
